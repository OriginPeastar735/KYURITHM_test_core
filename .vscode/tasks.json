{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: コンパイルのみ",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\.vscode\\arduino-upload.ps1", "-CompileOnly"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Arduino: コンパイルして書き込み",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\.vscode\\arduino-upload.ps1"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
